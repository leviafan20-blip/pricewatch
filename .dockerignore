# Keep local configuration, credentials, and private keys out of the build context.
**/.git
**/.env
**/.env.*
**/.envrc
**/.secrets
**/secrets
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519

# Python environments, bytecode, build products, and tool caches.
**/.venv
**/venv
**/env
**/__pycache__
**/*.py[cod]
**/*.mo
**/.Python
**/.tox
**/.nox
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
**/build
**/dist
**/*.egg-info

# Coverage, logs, and temporary files.
**/.coverage
**/.coverage.*
**/htmlcov
**/coverage
**/coverage.xml
**/*.cover
**/*.py,cover
**/*.log
**/logs
**/.tmp
**/tmp
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~

# Generated assets and user uploads. Source assets and test fixtures stay included.
**/staticfiles
**/media
**/artifacts

# Local databases, backups, and persistent Docker data.
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.dump
**/*.backup
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*_dump.sql
**/dump.sql
**/backup.sql
**/dumps
**/backups
**/pgdata
**/postgres-data
**/docker-data
**/.docker-data
**/celerybeat-schedule*

# IDE and operating-system generated files.
**/.idea
**/.vscode
**/.vs
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/$RECYCLE.BIN
**/*.stackdump
