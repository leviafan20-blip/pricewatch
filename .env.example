# Copy to .env; generate two different random values before the first start.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=pricewatch
POSTGRES_USER=pricewatch
# Optional host-side database connection (used by local Python, not Compose).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WEB_PORT=8000
# Exact reviewed domains, comma-separated; empty means no remote requests.
SCRAPING_ALLOWED_HOSTS=
# Host-side Python only; Compose uses its internal redis hostname.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
